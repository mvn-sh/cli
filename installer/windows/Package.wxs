<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="mvn.sh CLI" Manufacturer="mvn.sh" Version="$(var.Version)" UpgradeCode="A44ECA45-27F7-46E2-BB5B-BECDAFD43C15" Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of mvn.sh CLI is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="mvn.sh CLI">
        <Component Id="MvnshBinary" Guid="*">
          <File Id="MvnshExe" Source="$(var.Binary)" KeyPath="yes" />
          <Environment Id="AddToPath" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="MainFeature" Title="mvn.sh CLI" Level="1">
      <ComponentRef Id="MvnshBinary" />
    </Feature>
  </Package>
</Wix>
